{
  "name": "smart-mobility-backend",
  "version": "1.0.0",
  "description": "Backend API Gateway and Core Services for Smart Mobility MVP",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "PORT=3005 nodemon src/index.js",
    "build": "npm run build:auth && npm run build:vehicle && npm run build:ride && npm run build:payment",
    "build:auth": "cd auth-service && npm run build",
    "build:vehicle": "cd vehicle-service && npm run build",
    "build:ride": "cd ride-engine && npm run build",
    "build:payment": "cd payment-service && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "socket.io": "^4.7.4",
    "stripe": "^14.7.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "joi": "^17.11.0",
    "rate-limiter-flexible": "^4.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
