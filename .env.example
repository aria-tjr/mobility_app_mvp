# Copy to .env (backend/ and vehicle-simulator/) and fill in values. Never commit real .env files.
# Smart Mobility MVP Environment Configuration
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=

# Stripe (Test Mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Frontend URLs
FRONTEND_URL=http://localhost:3003
MOBILE_APP_URL=http://localhost:3004

# Simulator
SIMULATOR_PORT=3002

# ML Model Path
ML_MODEL_PATH=./models
